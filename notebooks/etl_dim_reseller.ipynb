import pandas as pd
from connection import connect
from deep_translator import GoogleTranslator

# connection
co_oltp, etl_conn = connect('sales')

#Extract

reseller = pd.read_sql("""
SELECT 
    BusinessEntityID,
    Name,
    NumberEmployees,
    AnnualSales,
    AnnualRevenue,
    BusinessType,
    YearOpened,
    BankName
FROM Sales.Reseller
""", co_oltp)

#Transform

reseller = reseller.rename(columns={
    'BusinessEntityID': 'reseller_alternate_key',
    'Name': 'reseller_name',
    'NumberEmployees': 'number_employees',
    'AnnualSales': 'annual_sales',
    'AnnualRevenue': 'annual_revenue',
    'BusinessType': 'business_type',
    'YearOpened': 'year_opened',
    'BankName': 'bank_name'
})

reseller['spanish_business_type'] = reseller['business_type'].apply(lambda x: GoogleTranslator(source='en', target='es').translate(x) if pd.notnull(x) else None)
reseller['french_business_type'] = reseller['business_type'].apply(lambda x: GoogleTranslator(source='en', target='fr').translate(x) if pd.notnull(x) else None)

#Load

reseller.to_sql('dim_reseller', etl_conn, if_exists='append', index=False)
print("Carga completada: dim_reseller")
