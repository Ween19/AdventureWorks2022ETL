import pandas as pd
from connection import connect
from deep_translator import GoogleTranslator

# connection
co_oltp, etl_conn = connect('sales')

#Extract

header = pd.read_sql("SELECT * FROM Sales.SalesOrderHeader", co_oltp)
detail = pd.read_sql("SELECT * FROM Sales.SalesOrderDetail", co_oltp)

#Transform

fact_reseller_sales = detail.merge(header, on='SalesOrderID', how='inner')

fact_reseller_sales = fact_reseller_sales.rename(columns={
    'ProductID': 'product_key',
    'SalesOrderID': 'sales_order_number',
    'SalesOrderDetailID': 'sales_order_line_number',
    'OrderQty': 'order_quantity',
    'UnitPrice': 'unit_price',
    'UnitPriceDiscount': 'unit_price_discount_pct',
    'OrderDate': 'order_date',
    'DueDate': 'due_date',
    'ShipDate': 'ship_date',
    'SalesPersonID': 'employee_key',
    'ResellerID': 'reseller_key',
    'TerritoryID': 'sales_territory_key'
})

fact_reseller_sales['sales_amount'] = fact_reseller_sales['unit_price'] * fact_reseller_sales['order_quantity'] * (1 - fact_reseller_sales['unit_price_discount_pct'])
fact_reseller_sales['total_product_cost'] = fact_reseller_sales['unit_price'] * fact_reseller_sales['order_quantity'] * 0.7

#Load

fact_reseller_sales.to_sql('fact_reseller_sales', etl_conn, if_exists='append', index=False)
print("Carga completada: fact_reseller_sales")
